      "topic": "Greetings and Small Talk",
      "items": [
        { "id": "1-1", "english": "Hello, good morning!", "german": "Hallo, guten Morgen!", "french": "Bonjour !" },
        { "id": "1-2", "english": "How are you doing today?", "german": "Wie geht es Ihnen heute?", "french": "Comment allez-vous aujourd'hui ?" },
        { "id": "1-3", "english": "I am doing well, thank you.", "german": "Mir geht es gut, danke.", "french": "Je vais bien, merci." },
        { "id": "1-4", "english": "Have a great day.", "german": "Einen schönen Tag noch.", "french": "Bonne journée." },
        { "id": "1-5", "english": "Good evening.", "german": "Guten Abend.", "french": "Bonsoir." },
        { "id": "1-6", "english": "It is nice to meet you.", "german": "Es freut mich, Sie kennenzulernen.", "french": "C'est un plaisir de vous rencontrer." },
        { "id": "1-7", "english": "My name is John.", "german": "Mein Name ist John.", "french": "Je m'appelle John." },
        { "id": "1-8", "english": "See you later.", "german": "Bis später.", "french": "À plus tard." }
      ]
    },
    {
      "topic": "Ordering Coffee",
      "items": [
        { "id": "2-1", "english": "Hello, I would like a large coffee with milk, please.", "german": "Hallo, ich hätte gerne einen großen Kaffee mit Milch, bitte.", "french": "Bonjour, je voudrais un grand café au lait, s'il vous plaît." },
        { "id": "2-2", "english": "To go, please.", "german": "Zum Mitnehmen, bitte.", "french": "À emporter, s'il vous plaît." },
        { "id": "2-3", "english": "I would also like a piece of cake.", "german": "Ich hätte auch gerne ein Stück Kuchen.", "french": "Je voudrais aussi une part de gâteau." },
        { "id": "2-4", "english": "How much does that cost in total?", "german": "Wie viel kostet das zusammen?", "french": "Combien ça coûte au total ?" },
        { "id": "2-5", "english": "Thank you, keep the change.", "german": "Danke, stimmt so.", "french": "Merci, gardez la monnaie." }
      ]
    },
    {
      "topic": "Common Useful Phrases",
      "items": [
        { "id": "3-1", "english": "Excuse me, do you speak English?", "german": "Entschuldigung, sprechen Sie Englisch?", "french": "Excusez-moi, parlez-vous anglais ?" },
        { "id": "3-2", "english": "My German and French are not very good yet.", "german": "Mein Deutsch und Französisch sind noch nicht sehr gut.", "french": "Mon allemand et mon français ne sont pas encore très bons." },
        { "id": "3-3", "english": "I am still learning.", "german": "Ich lerne noch.", "french": "J'apprends encore." },
        { "id": "3-4", "english": "I do not understand.", "german": "Ich verstehe nicht.", "french": "Je ne comprends pas." },
        { "id": "3-5", "english": "Could you please speak a little slower?", "german": "Könnten Sie bitte etwas langsamer sprechen?", "french": "Pourriez-vous parler un peu plus lentement, s'il vous plaît ?" },
        { "id": "3-6", "english": "Could you please repeat that?", "german": "Könnten Sie das bitte wiederholen?", "french": "Pourriez-vous répéter cela, s'il vous plaît ?" }
      ]
    },
    {
      "topic": "On the Go",
      "items": [
        { "id": "4-1", "english": "Excuse me, may I pass?", "german": "Entschuldigung, darf ich vorbei?", "french": "Excusez-moi, puis-je passer ?" },
        { "id": "4-2", "english": "Thank you very much.", "german": "Vielen Dank.", "french": "Merci beaucoup." },
        { "id": "4-3", "english": "The weather is beautiful today.", "german": "Das Wetter ist heute wunderschön.", "french": "Il fait beau aujourd'hui." },
        { "id": "4-4", "english": "Where is the restroom, please?", "german": "Wo ist bitte die Toilette?", "french": "Où sont les toilettes, s'il vous plaît ?" },
        { "id": "4-5", "english": "It is on the right side.", "german": "Sie ist auf der rechten Seite.", "french": "C'est à droite." }
